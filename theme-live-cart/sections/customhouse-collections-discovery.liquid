{% endstylesheet %}

{% javascript %}
(() => {
  const clean = (value) => String(value ?? '').trim();
  const normalize = (value) => clean(value).toLocaleLowerCase();
  const unique = (values) => [...new Set(values.map(clean).filter(Boolean))];
  const split = (value) => unique(clean(value).split('||'));
  const titleCase = (value) => clean(value).replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
  const parseJson = (value, fallback) => { try { return JSON.parse(value); } catch { return fallback; } };
  const asList = (value) => Array.isArray(value) ? unique(value) : value && typeof value === 'object' ? unique(Object.values(value)) : clean(value) ? [clean(value)] : [];

  function productionMethods(value) {
    const parsed = parseJson(value, null);
    const source = Array.isArray(parsed) ? parsed : Array.isArray(parsed?.productionMethods) ? parsed.productionMethods : [];
    return unique(source.map((method) => typeof method === 'string' ? method : method?.label || method?.id || method?.code || method?.method || ''));
  }

  document.querySelectorAll('[data-chd-root]').forEach((root) => {
    const cards = [...root.querySelectorAll('[data-chd-product]')];
    const grid = root.querySelector('[data-chd-product-grid]');
    const empty = root.querySelector('[data-chd-product-empty]');
    const activeFilters = root.querySelector('[data-chd-active-filters]');
    const resultCount = root.querySelector('[data-chd-result-count]');
    const sort = root.querySelector('[data-chd-sort]');
    const priceMin = root.querySelector('[data-chd-price-min]');
    const priceMax = root.querySelector('[data-chd-price-max]');
    const categoryTabs = [...root.querySelectorAll('[data-chd-category-tab]')];
    const filterDetails = [...root.querySelectorAll('[data-chd-filter]')];
    const selected = new Map(['category', 'fit', 'brand', 'color', 'method'].map((key) => [key, new Set()]));
    const urlState = new URLSearchParams(window.location.search);
    const requestedCategory = normalize(urlState.get('tab'));
    const initialTab = categoryTabs.find((button) => normalize(button.dataset.categoryHandle) === requestedCategory) || categoryTabs[0];
    let activeCategory = clean(initialTab?.dataset.categoryHandle);
    const records = cards.map((card, index) => ({
      card, index, title: clean(card.dataset.title), category: split(card.dataset.category),
      fit: asList(parseJson(card.dataset.fit, card.dataset.fit)), brand: clean(card.dataset.brand) ? [clean(card.dataset.brand)] : [],
      color: split(card.dataset.color), method: productionMethods(card.dataset.productionPricing),
      price: Number(card.dataset.price || 0), published: Number(card.dataset.published || 0),
    }));

    const valuesFor = (key) => unique(records.flatMap((record) => record[key] || [])).sort((a, b) => a.localeCompare(b));
    selected.forEach((values, key) => {
      const container = root.querySelector(`[data-chd-filter-options="${key}"]`);
      if (!container) return;
      const available = valuesFor(key);
      if (!available.length) {
        const message = document.createElement('span');
        message.className = 'chd-filter__empty';
        message.textContent = 'No options available';
        container.append(message);
        return;
      }
      available.forEach((value) => {
        const label = document.createElement('label');
        const input = document.createElement('input');
        const text = document.createElement('span');
        input.type = 'checkbox'; input.value = value; input.dataset.chdFacetInput = key;
        input.checked = urlState.getAll(key).some((item) => normalize(item) === normalize(value));
        if (input.checked) values.add(value);
        text.textContent = key === 'category' ? titleCase(value) : value;
        label.append(input, text); container.append(label);
      });
    });
    if (records.length && priceMin && priceMax) {
      const prices = records.map((record) => record.price).filter(Number.isFinite);
      priceMin.placeholder = String(Math.floor(Math.min(...prices) / 100));
      priceMax.placeholder = String(Math.ceil(Math.max(...prices) / 100));
      priceMin.value = urlState.get('price_min') || '';
      priceMax.value = urlState.get('price_max') || '';
    }
    if (sort && urlState.has('sort')) sort.value = urlState.get('sort');

    function syncUrl() {
      const params = new URLSearchParams(window.location.search);
      selected.forEach((values, key) => { params.delete(key); values.forEach((value) => params.append(key, value)); });
      ['price_min', 'price_max', 'sort'].forEach((key) => params.delete(key));
      params.delete('tab');
      if (clean(priceMin?.value)) params.set('price_min', clean(priceMin.value));
      if (clean(priceMax?.value)) params.set('price_max', clean(priceMax.value));
      if (sort?.value && sort.value !== 'relevant') params.set('sort', sort.value);
      if (activeCategory) params.set('tab', activeCategory);
      const query = params.toString();
      window.history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`);
    }

    function renderChips() {
      if (!activeFilters) return;
      activeFilters.replaceChildren();
      selected.forEach((values, key) => values.forEach((value) => {
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'chd-filter-chip'; button.dataset.key = key; button.dataset.value = value;
        button.textContent = `${titleCase(key)}: ${key === 'category' ? titleCase(value) : value} ×`;
        activeFilters.append(button);
      }));
      [['price_min', priceMin, 'Min price'], ['price_max', priceMax, 'Max price']].forEach(([key, input, label]) => {
        if (!clean(input?.value)) return;
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'chd-filter-chip'; button.dataset.priceKey = key;
        button.textContent = `${label}: ${input.value} ×`; activeFilters.append(button);
      });
    }

    const includesSelected = (record, key) => {
      const values = selected.get(key);
      if (!values?.size) return true;
      const actual = (record[key] || []).map(normalize);
      return [...values].some((value) => actual.includes(normalize(value)));
    };
    function applyProducts() {
      const min = clean(priceMin?.value) ? Number(priceMin.value) * 100 : null;
      const max = clean(priceMax?.value) ? Number(priceMax.value) * 100 : null;
      const visible = records.filter((record) => (!activeCategory || record.category.map(normalize).includes(normalize(activeCategory))) && [...selected.keys()].every((key) => includesSelected(record, key)) && (min === null || record.price >= min) && (max === null || record.price <= max));
      const order = [...records];
      if (sort?.value === 'newest') order.sort((a, b) => b.published - a.published || a.index - b.index);
      if (sort?.value === 'price-asc') order.sort((a, b) => a.price - b.price || a.index - b.index);
      if (sort?.value === 'price-desc') order.sort((a, b) => b.price - a.price || a.index - b.index);
      if (sort?.value === 'relevant') order.sort((a, b) => a.index - b.index);
      order.forEach((record) => grid?.append(record.card));
      records.forEach((record) => { record.card.hidden = !visible.includes(record); });
      if (empty) empty.hidden = visible.length > 0;
      if (resultCount) resultCount.textContent = String(visible.length);
      renderChips(); syncUrl();
    }

    root.addEventListener('change', (event) => {
      const input = event.target.closest('[data-chd-facet-input]');
      if (input) {
        const values = selected.get(input.dataset.chdFacetInput);
        if (input.checked) values?.add(input.value); else values?.delete(input.value);
      }
      if (input || event.target === sort || event.target === priceMin || event.target === priceMax) applyProducts();
    });
    root.addEventListener('input', (event) => { if (event.target === priceMin || event.target === priceMax) applyProducts(); });
    activeFilters?.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      if (button.dataset.key) {
        selected.get(button.dataset.key)?.delete(button.dataset.value);
        root.querySelectorAll(`[data-chd-facet-input="${button.dataset.key}"]`).forEach((input) => { if (input.value === button.dataset.value) input.checked = false; });
      }
      if (button.dataset.priceKey === 'price_min' && priceMin) priceMin.value = '';
      if (button.dataset.priceKey === 'price_max' && priceMax) priceMax.value = '';
      applyProducts();
    });
    const filterToggle = root.querySelector('[data-chd-filter-toggle]');
    const filterPanel = root.querySelector('[data-chd-filter-panel]');
    filterToggle?.addEventListener('click', () => {
      const open = filterPanel?.classList.toggle('is-open') || false;
      filterToggle.setAttribute('aria-expanded', String(open));
    });
    filterDetails.forEach((details) => details.addEventListener('toggle', () => {
      if (!details.open) return;
      filterDetails.forEach((other) => {
        if (other !== details) other.open = false;
      });
    }));
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      filterDetails.forEach((details) => { details.open = false; });
    });
    root.querySelectorAll('[data-chd-view]').forEach((button) => button.addEventListener('click', () => {
      grid?.classList.toggle('is-list-view', button.dataset.chdView === 'list');
      root.querySelectorAll('[data-chd-view]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    }));
    function activateCategory(button, moveFocus = false) {
      if (!button) return;
      activeCategory = clean(button.dataset.categoryHandle);
      categoryTabs.forEach((item) => {
        const selectedTab = item === button;
        item.classList.toggle('is-active', selectedTab);
        item.setAttribute('aria-selected', String(selectedTab));
        item.tabIndex = selectedTab ? 0 : -1;
      });
      if (grid && button.id) grid.setAttribute('aria-labelledby', button.id);
      if (moveFocus) button.focus();
      applyProducts();
    }
    categoryTabs.forEach((button, index) => {
      button.addEventListener('click', () => activateCategory(button));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + categoryTabs.length) % categoryTabs.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % categoryTabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = categoryTabs.length - 1;
        activateCategory(categoryTabs[nextIndex], true);
      });
    });
    if (initialTab) activateCategory(initialTab);
  });
})();
{% endjavascript %}
