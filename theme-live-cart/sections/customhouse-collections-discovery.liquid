{% liquid
  assign source_collection = section.settings.base_products_collection
  assign product_limit = section.settings.product_limit | default: 48 | plus: 0
  assign hero_image = section.settings.hero_image
  if hero_image == blank and source_collection.image != blank
    assign hero_image = source_collection.image
  endif
  if hero_image == blank
    for hero_product in source_collection.products
      assign hero_origin = hero_product.metafields.customhouse.product_origin.value | downcase
      assign hero_type = hero_product.metafields.customhouse.product_type.value | downcase
      assign hero_mode = hero_product.metafields.customhouse.design_mode.value | downcase
      if hero_origin == 'global' or hero_type == 'global_customizable' or hero_mode == 'customizable'
        if hero_product.featured_image != blank
          assign hero_image = hero_product.featured_image
          break
        endif
      endif
    endfor
  endif
%}

<section
  id="CustomHouseCollectionsDiscovery-{{ section.id }}"
  class="customhouse-collections-discovery"
  data-chd-root
>
  <div class="chd-container">
    <nav class="chd-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span>Collections</span><span aria-hidden="true">›</span><strong>Base products</strong>
    </nav>

    <header class="chd-hero">
      <div class="chd-hero__content">
        <p class="chd-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1><span>{{ section.settings.hero_heading | escape }}</span><strong>{{ section.settings.hero_accent | escape }}</strong></h1>
        <p class="chd-hero__copy">{{ section.settings.hero_copy | escape }}</p>
        <ul class="chd-value-list" role="list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.2 2 5 13h6l-.2 9L19 10h-6l.2-8Z"/></svg><span><strong>Premium quality</strong><small>Built to last</small></span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 15l9 5 9-5"/></svg><span><strong>Your design</strong><small>Print, embroidery or patch</small></span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h13v11H2V5Zm13 4h4l3 4v3h-7V9ZM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg><span><strong>Worldwide shipping</strong><small>Fast and reliable</small></span></li>
        </ul>
      </div>
      <div class="chd-hero__art">
        <svg class="chd-hero__crown" viewBox="0 0 90 70" aria-hidden="true"><path d="M8 56 2 22l24 18L45 7l19 33 24-18-7 34H8Zm0 9h73"/></svg>
        <span class="chd-hero__slash chd-hero__slash--lime" aria-hidden="true"></span>
        <span class="chd-hero__slash chd-hero__slash--purple" aria-hidden="true"></span>
        {% if hero_image != blank %}
          {{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480,720,1000,1400', sizes: '(max-width: 767px) 100vw, 52vw', alt: section.settings.hero_image_alt, class: 'chd-hero__image' }}
        {% else %}
          <div class="chd-hero__fallback" aria-hidden="true"></div>
        {% endif %}
      </div>
    </header>

    <nav class="chd-categories" aria-label="Product categories" role="tablist">
      <div class="chd-categories__track">
        {% liquid
          assign default_category_handles = 't-shirts,hoodies,pants,caps,accessories' | split: ','
          assign default_category_labels_english = 'T-SHIRTS,HOODIES,PANTS,CAPS,ACCESSORIES' | split: ','
          assign default_category_descriptions_english = 'Everyday premium tees||Heavyweight layers||Built for movement||Finish the look||Details that stand out' | split: '||'
          assign category_labels = default_category_labels_english
          assign category_descriptions = 'Design your t-shirt||Design your hoodie||Joggers, sweatpants & more||Design your cap||Stickers, bags & more' | split: '||'
          if request.locale.iso_code == 'sv'
            assign category_labels = 'T-SHIRTAR,HUVTRÖJOR,BYXOR,KEPSAR,ACCESSOARER' | split: ','
            assign category_descriptions = 'Designa din t-shirt||Designa din huvtröja||Joggingbyxor, mjukisbyxor och mer||Designa din keps||Klistermärken, väskor och mer' | split: '||'
          endif
        %}
        {% for category_handle in default_category_handles %}
          {% liquid
            assign category_block = section.blocks[forloop.index0]
            assign category_label = category_labels[forloop.index0]
            assign category_description = category_descriptions[forloop.index0]
            if category_block.settings.label != blank and category_block.settings.label != default_category_labels_english[forloop.index0]
              assign category_label = category_block.settings.label
            endif
            if category_block.settings.description != blank and category_block.settings.description != default_category_descriptions_english[forloop.index0]
              assign category_description = category_block.settings.description
            endif
          %}
          <button
            id="chd-category-tab-{{ section.id }}-{{ category_handle }}"
            class="chd-category{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="chd-product-grid-{{ section.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-chd-category-tab
            data-category-handle="{{ category_handle }}"
          >
            <span class="chd-category__icon" aria-hidden="true">
              {% case forloop.index %}
                {% when 1 %}<svg viewBox="0 0 36 36"><path d="m12 6 6 3 6-3 8 5-4 7-4-2v14H12V16l-4 2-4-7 8-5Z"/></svg>
                {% when 2 %}<svg viewBox="0 0 36 36"><path d="M10 14 14 7h8l4 7 5 4-3 12H8L5 18l5-4Zm4-7 4 5 4-5"/></svg>
                {% when 3 %}<svg viewBox="0 0 36 36"><path d="M12 5h12l2 25h-7l-1-15-1 15h-7l2-25Zm0 6h12"/></svg>
                {% when 4 %}<svg viewBox="0 0 36 36"><path d="M5 20c2-9 8-14 15-14 6 0 10 4 12 10-5 0-10 1-14 4H5Zm13 0c7 0 12 2 14 5H18"/></svg>
                {% else %}<svg viewBox="0 0 36 36"><path d="M8 12h20l3 19H5l3-19Zm6 2V9a4 4 0 0 1 8 0v5"/></svg>
              {% endcase %}
            </span>
            <span><strong>{{ category_label | escape }}</strong><small>{{ category_description | escape }}</small></span>
          </button>
        {% endfor %}
      </div>
    </nav>

    <div id="chd-base-products-{{ section.id }}" class="chd-base">
      {% if source_collection != blank %}
        <div class="chd-toolbar" data-chd-toolbar>
          <button class="chd-filter-toggle" type="button" data-chd-filter-toggle aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>Filters <span data-chd-result-count></span></button>
          <div class="chd-filter-panel" data-chd-filter-panel>
            {% assign filter_names = 'category:Category,fit:Fit,brand:Brand,color:Color,method:Print method' | split: ',' %}
            {% for filter_definition in filter_names %}
              {% assign filter_parts = filter_definition | split: ':' %}
              <details class="chd-filter" data-chd-filter="{{ filter_parts[0] }}">
                <summary>{{ filter_parts[1] }}: <b>All</b><svg class="chd-filter__chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></summary>
                <div class="chd-filter__options" data-chd-filter-options="{{ filter_parts[0] }}"></div>
              </details>
            {% endfor %}
            <details class="chd-filter chd-filter--price" data-chd-filter="price">
              <summary>Price: <b>All</b><svg class="chd-filter__chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></summary>
              <div class="chd-price-range"><label>Min <input type="number" min="0" step="1" inputmode="numeric" data-chd-price-min></label><label>Max <input type="number" min="0" step="1" inputmode="numeric" data-chd-price-max></label></div>
            </details>
          </div>
          <div class="chd-toolbar__end">
            <label class="chd-sort"><span>Sort by:</span><select data-chd-sort><option value="relevant">Most relevant</option><option value="newest">Newest</option><option value="price-asc">Price low to high</option><option value="price-desc">Price high to low</option></select></label>
            <div class="chd-view-switcher" aria-label="Product layout">
              <button type="button" data-chd-view="grid" aria-pressed="true" aria-label="Grid view"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 2h6v6H2V2Zm10 0h6v6h-6V2ZM2 12h6v6H2v-6Zm10 0h6v6h-6v-6Z"/></svg></button>
              <button type="button" data-chd-view="list" aria-pressed="false" aria-label="List view"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3h4v4H2V3Zm7 1h9v2H9V4ZM2 9h4v4H2V9Zm7 1h9v2H9v-2ZM2 15h4v4H2v-4Zm7 1h9v2H9v-2Z"/></svg></button>
            </div>
          </div>
        </div>
        <div class="chd-active-filters" data-chd-active-filters aria-live="polite"></div>

        <div id="chd-product-grid-{{ section.id }}" class="chd-product-grid" role="tabpanel" aria-labelledby="chd-category-tab-{{ section.id }}-t-shirts" data-chd-product-grid>
          {% liquid
            assign rendered_products = 0
            assign rendered_product_ids = '|'
            assign has_category_collections = false
            capture category_collection_handles
              for category_block in section.blocks
                assign category_collection = category_block.settings.collection
                if category_collection != blank
                  assign has_category_collections = true
                  echo category_collection.handle
                  echo '||'
                endif
              endfor
            endcapture
            unless has_category_collections
              assign category_collection_handles = source_collection.handle
            endunless
            assign category_collection_handles = category_collection_handles | strip | split: '||'
          %}
          {% for category_collection_handle in category_collection_handles %}
            {% assign category_collection = collections[category_collection_handle] %}
            {% for product in category_collection.products limit: product_limit %}
              {% assign product_key = product.id | prepend: '|' | append: '|' %}
              {% unless rendered_product_ids contains product_key %}
                {% if rendered_products < product_limit %}
            {% liquid
              assign product_origin = product.metafields.customhouse.product_origin.value | downcase
              assign design_mode = product.metafields.customhouse.design_mode.value | downcase
              assign product_type = product.metafields.customhouse.product_type.value | downcase
              assign pitchprint_enabled = product.metafields.customhouse.pitchprint_enabled.value
              assign is_creator_product = false
              if product_origin == 'creator' or design_mode == 'buy_only' or product_type == 'creator_fixed'
                assign is_creator_product = true
              endif
              assign is_global_product = false
              if product_origin == 'global' or product_type == 'global_customizable' or design_mode == 'customizable'
                assign is_global_product = true
              endif
            %}
            {% if is_creator_product == false and is_global_product %}
              {% assign rendered_products = rendered_products | plus: 1 %}
              {% assign rendered_product_ids = rendered_product_ids | append: product_key %}
              {% capture product_collection_keys %}{% for product_collection in product.collections %}|{{ product_collection.handle }}|{% endfor %}{% endcapture %}
              {% capture product_categories %}{% for product_collection in product.collections %}{{ product_collection.handle }}{% unless forloop.last %}||{% endunless %}{% endfor %}{% endcapture %}
              {% capture configured_category_aliases %}
                {% for category_block in section.blocks %}
                  {% assign category_collection = category_block.settings.collection %}
                  {% assign category_collection_key = category_collection.handle | prepend: '|' | append: '|' %}
                  {% assign category_alias = default_category_handles[forloop.index0] %}
                  {% if category_collection != blank and product_collection_keys contains category_collection_key and category_alias != blank %}||{{ category_alias }}{% endif %}
                {% endfor %}
              {% endcapture %}
              {% assign product_categories = product_categories | append: configured_category_aliases %}
              {% capture product_colors %}{% for option in product.options_with_values %}{% assign normalized_option = option.name | downcase %}{% if normalized_option contains 'color' or normalized_option contains 'colour' %}{% for value in option.values %}{{ value }}{% unless forloop.last %}||{% endunless %}{% endfor %}{% endif %}{% endfor %}{% endcapture %}
              <article class="chd-product-card" data-chd-product data-index="{{ rendered_products }}" data-title="{{ product.title | escape }}" data-category="{{ product_categories | strip | escape }}" data-fit="{{ product.metafields.customhouse.fit.value | json | escape }}" data-brand="{{ product.vendor | escape }}" data-color="{{ product_colors | strip | escape }}" data-price="{{ product.price_min }}" data-published="{{ product.published_at | date: '%s' }}" data-production-pricing="{{ product.metafields.customhouse.production_method_pricing.value | json | escape }}">
                <a class="chd-product-card__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                  {% if product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240,360,480,720', sizes: '(max-width: 520px) 100vw, (max-width: 767px) 50vw, (max-width: 1199px) 33vw, 20vw', alt: product.title }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'chd-product-card__placeholder' }}
                  {% endif %}
                </a>
                <div class="chd-product-card__body">
                  <p class="chd-product-card__vendor">{{ product.vendor | default: shop.name | escape }}<span aria-hidden="true">◆</span></p>
                  <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
                  <strong class="chd-product-card__price">{{ product.price_min | money }}{% if product.price_varies %}+{% endif %}</strong>
                  <div class="chd-product-card__actions">
                    {% if pitchprint_enabled == true %}<a class="chd-button chd-button--customize" href="{{ product.url }}?open_customizer=1"><span aria-hidden="true">✎</span> Customize</a>{% endif %}
                    <a class="chd-button chd-button--view" href="{{ product.url }}">View product <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </article>
            {% endif %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          {% endfor %}
        </div>
        <div class="chd-empty" data-chd-product-empty hidden>No base products match these filters.</div>
        {% if rendered_products == 0 %}<div class="chd-setup-note">Select a collection containing products classified as <code>global_customizable</code> in this section's settings.</div>{% endif %}
      {% else %}
        <div class="chd-setup-note">Choose the real Base Products collection in the Theme Editor.</div>
      {% endif %}
    </div>

    <aside class="chd-cta">
      <svg class="chd-cta__crown" viewBox="0 0 90 70" aria-hidden="true"><path d="M8 56 2 22l24 18L45 7l19 33 24-18-7 34H8Zm0 9h73"/></svg>
      <h2>{{ section.settings.cta_heading | escape }}</h2>
      <p>{{ section.settings.cta_copy | escape }}</p>
      <a class="chd-button chd-button--cta" href="{{ section.settings.design_studio_url | default: '/pages/design-studio' | escape }}">Start designing <span aria-hidden="true">→</span></a>
    </aside>

  </div>
</section>

{% schema %}
{
  "name": "Collections discovery",
  "tag": "section",
  "class": "customhouse-collections-discovery-section",
  "settings": [
    { "type": "collection", "id": "base_products_collection", "label": "Base products collection" },
    { "type": "range", "id": "product_limit", "label": "Maximum base products", "min": 8, "max": 48, "step": 4, "default": 48 },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "CUSTOMHOUSE ORIGINALS" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "BASE PRODUCTS" },
    { "type": "text", "id": "hero_accent", "label": "Hero accent heading", "default": "DESIGN YOUR OWN" },
    { "type": "textarea", "id": "hero_copy", "label": "Hero copy", "default": "High-quality blanks for your ideas. Customize with print, embroidery or patch. No limits, make it truly yours." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "CustomHouse base products" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "CREATE SOMETHING UNIQUE" },
    { "type": "textarea", "id": "cta_copy", "label": "CTA copy", "default": "Choose a real product, add your design and make it yours in minutes." },
    { "type": "url", "id": "design_studio_url", "label": "Design Studio link" },
    { "type": "text", "id": "creator_endpoint", "label": "Creator directory app-proxy endpoint", "default": "/apps/customhouse/creators?format=json" }
  ],
  "blocks": [{ "type": "category", "name": "Category link", "limit": 5, "settings": [{ "type": "text", "id": "label", "label": "Label" }, { "type": "text", "id": "description", "label": "Description" }, { "type": "collection", "id": "collection", "label": "Collection" }] }],
  "presets": [{ "name": "Collections discovery" }]
}
{% endschema %}

{% stylesheet %}
.customhouse-collections-discovery {
  --chd-bg: #08090a; --chd-panel: #111214; --chd-line: #34363b; --chd-text: #f8f8f5;
  --chd-muted: #a3a4a9; --chd-lime: #baff00; --chd-purple: #842bff;
  overflow: hidden; padding: 0 0 18px; background: var(--chd-bg); color: var(--chd-text); font-family: Arial, Helvetica, sans-serif;
}
.customhouse-collections-discovery *, .customhouse-collections-discovery *::before, .customhouse-collections-discovery *::after { box-sizing: border-box; }
.customhouse-collections-discovery a { color: inherit; text-decoration: none; }
.customhouse-collections-discovery button, .customhouse-collections-discovery input, .customhouse-collections-discovery select { font: inherit; }
.customhouse-collections-discovery .chd-container { width: min(1460px, calc(100% - 48px)); margin: 0 auto; }
.customhouse-collections-discovery .chd-breadcrumb { min-height: 42px; display: flex; align-items: center; gap: 9px; color: #777a80; font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
.customhouse-collections-discovery .chd-breadcrumb a:hover, .customhouse-collections-discovery .chd-breadcrumb strong { color: var(--chd-purple); }
.customhouse-collections-discovery .chd-hero { min-height: 330px; display: grid; grid-template-columns: 55% 45%; position: relative; overflow: hidden; border: 1px solid var(--chd-line); border-bottom: 0; background: radial-gradient(circle at 72% 40%, #25252a 0, #111216 46%, #090a0b 75%); }
.customhouse-collections-discovery .chd-hero__content { position: relative; z-index: 3; padding: 32px 0 30px 28px; }
.customhouse-collections-discovery .chd-eyebrow { margin: 0 0 8px; color: var(--chd-lime); font-size: 10px; font-weight: 900; letter-spacing: .17em; text-transform: uppercase; }
.customhouse-collections-discovery .chd-hero h1 { max-width: 720px; margin: 0; font-size: clamp(44px, 4.2vw, 62px); font-weight: 1000; letter-spacing: -.065em; line-height: .84; text-transform: uppercase; transform: skew(-5deg); }
.customhouse-collections-discovery .chd-hero h1 span, .customhouse-collections-discovery .chd-hero h1 strong { display: block; }
.customhouse-collections-discovery .chd-hero h1 span { white-space: nowrap; }
.customhouse-collections-discovery .chd-hero h1 strong { margin-top: 12px; color: var(--chd-lime); font-size: .67em; letter-spacing: -.045em; }
.customhouse-collections-discovery .chd-hero__copy { max-width: 540px; margin: 20px 0 18px; color: #d1d1d4; font-size: 15px; line-height: 1.45; }
.customhouse-collections-discovery .chd-value-list { max-width: 650px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
.customhouse-collections-discovery .chd-value-list li { min-width: 0; display: flex; align-items: center; gap: 10px; }
.customhouse-collections-discovery .chd-value-list svg { width: 29px; height: 29px; flex: 0 0 auto; fill: none; stroke: var(--chd-lime); stroke-width: 1.8; }
.customhouse-collections-discovery .chd-value-list strong, .customhouse-collections-discovery .chd-value-list small { display: block; }
.customhouse-collections-discovery .chd-value-list strong { font-size: 10px; text-transform: uppercase; }
.customhouse-collections-discovery .chd-value-list small { margin-top: 2px; color: var(--chd-muted); font-size: 9px; }
.customhouse-collections-discovery .chd-hero__art { position: relative; min-width: 0; min-height: 330px; display: flex; align-items: center; justify-content: flex-end; isolation: isolate; }
.customhouse-collections-discovery .chd-hero__art::before, .customhouse-collections-discovery .chd-hero__art::after { content: ''; position: absolute; z-index: -1; top: -70px; right: 20%; width: 38px; height: 470px; transform: rotate(47deg); background: var(--chd-lime); box-shadow: 0 0 45px rgba(186,255,0,.3); }
.customhouse-collections-discovery .chd-hero__art::after { right: 8%; background: var(--chd-purple); box-shadow: 0 0 45px rgba(132,43,255,.35); }
.customhouse-collections-discovery .chd-hero__image { width: min(100%, 330px); height: auto; min-height: 0; aspect-ratio: 1 / 1; display: block; margin-left: auto; object-fit: cover; object-position: center 28%; filter: saturate(.9) contrast(1.08); mask-image: linear-gradient(90deg, transparent 0, #000 18%, #000 100%); }
.customhouse-collections-discovery .chd-hero__fallback { width: min(100%, 330px); min-height: 0; aspect-ratio: 1 / 1; margin-left: auto; background: linear-gradient(120deg, transparent 0 33%, #151619 33% 67%, transparent 67%), radial-gradient(circle at 50% 80%, #2b2c30, #101114 58%); }
.customhouse-collections-discovery .chd-hero__crown { position: absolute; z-index: 2; top: 30px; left: 9%; width: 64px; fill: none; stroke: var(--chd-lime); stroke-width: 4; transform: rotate(-8deg); }
.customhouse-collections-discovery .chd-hero__slash { position: absolute; z-index: 2; right: 6%; bottom: 22px; width: 110px; height: 8px; transform: rotate(-18deg); background: var(--chd-lime); }
.customhouse-collections-discovery .chd-hero__slash--purple { right: 1%; bottom: 5px; background: var(--chd-purple); }
.customhouse-collections-discovery .chd-categories { border: 1px solid var(--chd-line); background: #0d0e10; }
.customhouse-collections-discovery .chd-categories__track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; padding: 8px; }
.customhouse-collections-discovery .chd-category { width: 100%; min-width: 0; min-height: 68px; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 0 12px; border: 1px solid #45474c; border-radius: 9px; background: linear-gradient(180deg, #18191c, #111214); color: var(--chd-text); text-align: left; cursor: pointer; transition: border-color .2s, transform .2s, background .2s; }
.customhouse-collections-discovery .chd-category:hover { border-color: var(--chd-purple); transform: translateY(-1px); }
.customhouse-collections-discovery .chd-category.is-active { border-color: var(--chd-lime); background: linear-gradient(180deg, rgba(186,255,0,.08), #111214); box-shadow: 0 0 0 1px rgba(186,255,0,.18) inset; }
.customhouse-collections-discovery .chd-category__icon { width: 34px; height: 34px; color: #fff; }
.customhouse-collections-discovery .chd-category__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.8; }
.customhouse-collections-discovery .chd-category.is-active .chd-category__icon { color: var(--chd-lime); }
.customhouse-collections-discovery .chd-category strong, .customhouse-collections-discovery .chd-category small { display: block; }
.customhouse-collections-discovery .chd-category strong { font-size: 12px; text-transform: uppercase; }
.customhouse-collections-discovery .chd-category small { margin-top: 3px; color: var(--chd-muted); font-size: 9px; }
