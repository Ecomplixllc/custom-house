{%- doc -%}
  Adds the Creator Content discovery route only when the merchant-managed menu
  does not already contain it.

  @param {object} links - Top-level menu links
  @param {string} variant - desktop, mobile_bar, or drawer
  @param {object} [block_settings] - Header block settings for drawer dividers
{%- enddoc -%}

{% liquid
  assign creator_content_links = links | where: 'url', '/apps/customhouse/creator-content'
  assign creator_content_active = false
  if request.path == '/apps/customhouse/creator-content'
    assign creator_content_active = true
  endif
%}

{% if creator_content_links.size == 0 %}
  {% case variant %}
    {% when 'mobile_bar' %}
      <li>
        <a
          href="/apps/customhouse/creator-content"
          id="MenuItem-customhouse-creator-content"
          class="menu-list__item"
          {% if creator_content_active %}aria-current="page"{% endif %}
        >CREATOR CONTENT</a>
      </li>
    {% when 'drawer' %}
      <li
        class="menu-drawer__list-item{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
        style="--menu-drawer-animation-index: {{ links.size | plus: 2 }};"
      >
        <a
          id="HeaderDrawer-customhouse-creator-content"
          href="/apps/customhouse/creator-content"
          class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element focus-inset{% if creator_content_active %} menu-drawer__menu-item--active{% endif %}"
          {% if creator_content_active %}aria-current="page"{% endif %}
        >
          <span class="menu-drawer__menu-item-text wrap-text">CREATOR CONTENT</span>
        </a>
      </li>
    {% else %}
      <li role="presentation" class="menu-list__list-item">
        <a
          href="/apps/customhouse/creator-content"
          data-skip-node-update="true"
          class="menu-list__link{% if creator_content_active %} menu-list__link--active{% endif %}"
          {% if creator_content_active %}aria-current="page"{% endif %}
        >
          <span class="menu-list__link-title">CREATOR CONTENT</span>
        </a>
      </li>
  {% endcase %}
{% endif %}
