{%- doc -%}
  Renders the merchant-managed Shopify navigation in the custom header.

  @param {object} links - Links from the menu selected in the Header settings
  @param {string} variant - desktop or mobile
  @param {string} request_path - Current storefront path
{%- enddoc -%}

{% liquid
  assign navigation_links = links
  if navigation_links == blank
    assign navigation_links = linklists['main-menu'].links
  endif
%}

{% for link in navigation_links %}
  {% liquid
    assign item_url = link.url
    assign item_key = link.handle
    assign is_current = link.current | default: link.active

    if item_url contains '/apps/customhouse/creator-content' or item_url contains '/apps/customhouse/creators/'
      assign item_key = 'creator-content'
      if request_path == '/apps/customhouse/creator-content' or request_path contains '/apps/customhouse/creators/'
        assign is_current = true
      endif
    elsif item_url contains '/collections/t-shirts'
      assign item_key = 't-shirts'
    elsif item_url contains '/collections/hoodies'
      assign item_key = 'hoodies'
    elsif item_url contains '/pages/design-selv'
      assign item_key = 'design-selv'
    elsif item_url contains '/blogs/news'
      assign item_key = 'inspiration'
    elsif item_url contains '/pages/collections'
      assign item_key = 'design-your-own'
    endif
  %}
  {% if variant == 'mobile' %}
    <a href="{{ item_url }}"{% if is_current %} aria-current="page"{% endif %}>
      <span class="customhouse-mobile-drawer__line-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          {% case item_key %}
            {% when 't-shirts' %}
              <path d="M17 8h14l10 8-5 8-5-3v19H17V21l-5 3-5-8 10-8Z"></path>
              <path d="M20 8c1.1 3 2.4 4.5 4 4.5S26.9 11 28 8"></path>
              <path d="M18 35h12"></path>
            {% when 'hoodies' %}
              <path d="M15 20c0-7.6 3.8-13 9-13s9 5.4 9 13"></path>
              <path d="M13 18 7 32l8 4 3-8v13h12V28l3 8 8-4-6-14"></path>
              <path d="M18 20h12"></path>
              <path d="M21 41v-8h6v8"></path>
            {% when 'design-selv' %}
              <path d="M10 37 36 11l6 6-26 26-8 2 2-8Z"></path>
              <path d="m31 16 6 6"></path>
              <path d="M8 43h26"></path>
            {% when 'inspiration' %}
              <path d="M18 30c-2.8-2.2-4.5-5.3-4.5-9 0-6.3 4.7-11 10.5-11s10.5 4.7 10.5 11c0 3.7-1.7 6.8-4.5 9"></path>
              <path d="M19 34h10"></path>
              <path d="M20.5 39h7"></path>
              <path d="M24 3v4M9 10l3 3M39 10l-3 3M7 22h4M37 22h4"></path>
            {% when 'design-your-own' %}
              <path d="M8 36h32l-3-20-9 9-4-14-4 14-9-9-3 20Z"></path>
              <path d="M10 41h28"></path>
            {% when 'creator-content' %}
              <circle cx="17" cy="17" r="7"></circle>
              <circle cx="33" cy="19" r="5"></circle>
              <path d="M5 40c1.6-8 5.6-12 12-12s10.4 4 12 12"></path>
              <path d="M27 30c6.8 0 11 3.3 12.5 10"></path>
            {% else %}
              <path d="M8 12h32M8 24h32M8 36h32"></path>
          {% endcase %}
        </svg>
      </span>
      <span>{{ link.title }}</span>
    </a>
  {% else %}
    <a href="{{ item_url }}"{% if is_current %} aria-current="page"{% endif %}>{{ link.title }}</a>
  {% endif %}
{% endfor %}
